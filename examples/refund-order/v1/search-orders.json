{
  "name": "search_orders",
  "description": "Searches orders by customer and status",
  "inputSchema": {
    "type": "object",
    "properties": {
      "customerId": { "type": "string", "description": "Customer whose orders to search" },
      "status": { "type": "string", "enum": ["open", "shipped", "cancelled"] },
      "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
      "includeItems": { "type": "boolean" },
      "dateRange": {
        "type": "object",
        "properties": { "from": { "type": "string" }, "to": { "type": "string" } },
        "required": ["from"]
      }
    },
    "required": ["customerId"]
  }
}
